// ============================================================
// Firebase Storage Security Rules — RentHub
// Deploy via: firebase deploy --only storage
// ============================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --------------------------------------------------------
    // Ad images: ads/{userId}/{adId}/image-{n}
    // --------------------------------------------------------
    match /ads/{userId}/{allPaths=**} {
      // Public can read all images
      allow read: if true;

      // Only the authenticated owner can upload
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5MB max
        && request.resource.contentType.matches('image/.*');

      // Owner or admin can delete
      allow delete: if request.auth != null
        && (request.auth.uid == userId
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
