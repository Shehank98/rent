// ============================================================
// Firestore Security Rules — RentHub Sri Lanka
//
// HOW TO DEPLOY:
//   Option A (Firebase Console):
//     1. Go to Firebase Console → Firestore Database → Rules tab
//     2. Replace everything with the content below → Publish
//
//   Option B (CLI):
//     firebase deploy --only firestore:rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------
    // HELPERS
    // --------------------------------------------------------
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Checks Firestore itself — safe even if user doc doesn't exist yet
    function isAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --------------------------------------------------------
    // USERS COLLECTION  /users/{userId}
    // --------------------------------------------------------
    match /users/{userId} {
      // Anyone (including unauthenticated) can read user profiles
      // Needed for: displaying poster name on ad page
      allow read: if true;

      // Authenticated user can create their own document
      // Role is forced to "user" — cannot self-assign admin
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.uid == userId;

      // User can update their own doc but CANNOT change their role or verified status
      // Admin can update any user (including role and verified assignment)
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('verified', false) == resource.data.get('verified', false));

      // Only admin can delete a user document
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------
    // ADS COLLECTION  /ads/{adId}
    // --------------------------------------------------------
    match /ads/{adId} {

      // READ:
      //   - Public: only approved ads
      //   - Owner: their own ads (any status)
      //   - Admin: all ads
      allow read: if resource.data.status == 'approved'
        || (isAuth() && resource.data.userId == request.auth.uid)
        || isAdmin();

      // CREATE:
      //   - Must be authenticated
      //   - userId must match the creator
      //   - Status must start as "pending"
      //   - Featured must start as false
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.featured == false;

      // UPDATE:
      //   - Admin can update anything (status, featured, etc.)
      //   - Owner can update their OWN ad only while it is still pending,
      //     and cannot change status or featured themselves
      allow update: if isAdmin()
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.featured == false
            && request.resource.data.userId == resource.data.userId);

      // DELETE: owner or admin
      allow delete: if isAuth()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --------------------------------------------------------
    // CATEGORIES COLLECTION  /categories/{catId}
    // Public can read; only admin can write
    // --------------------------------------------------------
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --------------------------------------------------------
    // Deny everything else by default
    // --------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
