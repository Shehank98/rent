// ============================================================
// Firestore Security Rules — RentHub Sri Lanka
//
// HOW TO DEPLOY:
//   Option A (Firebase Console):
//     1. Go to Firebase Console → Firestore Database → Rules tab
//     2. Replace everything with the content below → Publish
//
//   Option B (CLI):
//     firebase deploy --only firestore:rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------
    // HELPERS
    // --------------------------------------------------------
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Checks Firestore itself — safe even if user doc doesn't exist yet
    function isAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --------------------------------------------------------
    // USERS COLLECTION  /users/{userId}
    // --------------------------------------------------------
    match /users/{userId} {
      // Anyone (including unauthenticated) can read user profiles
      // Needed for: displaying poster name on ad page
      allow read: if true;

      // Authenticated user can create their own document
      // Role is forced to "user" — cannot self-assign admin
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.uid == userId;

      // User can update their own doc but CANNOT change their role or verified status
      // Admin can update any user (including role and verified assignment)
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('verified', false) == resource.data.get('verified', false));

      // Only admin can delete a user document
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------
    // ADS COLLECTION  /ads/{adId}
    // --------------------------------------------------------
    match /ads/{adId} {

      // READ:
      //   - Public: only approved ads
      //   - Owner: their own ads (any status)
      //   - Admin: all ads
      allow read: if resource.data.status == 'approved'
        || (isAuth() && resource.data.userId == request.auth.uid)
        || isAdmin();

      // CREATE:
      //   - Admin can create any ad (e.g., seeding test data)
      //   - Regular users: userId must match creator, status=pending, featured=false
      allow create: if isAdmin()
        || (isAuth()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.featured == false);

      // UPDATE:
      //   - Admin can update anything (status, featured, etc.)
      //   - Owner can update their OWN ad (any status - pending, rejected, or approved),
      //     editing always resets status back to "pending" for re-review;
      //     cannot change featured flag or userId
      allow update: if isAdmin()
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.featured == resource.data.featured
            && request.resource.data.userId == resource.data.userId);

      // DELETE: owner or admin
      allow delete: if isAuth()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --------------------------------------------------------
    // CATEGORIES COLLECTION  /categories/{catId}
    // Public can read; only admin can write
    // --------------------------------------------------------
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --------------------------------------------------------
    // MESSAGES COLLECTION  /messages/{msgId}
    // Admin sends messages to listing owners; owners read their own
    // --------------------------------------------------------
    match /messages/{msgId} {
      allow create: if isAdmin();
      allow read:   if isAdmin()
        || (isAuth() && resource.data.toUid == request.auth.uid);
      // Owner can only update the 'read' flag on their own message
      allow update: if isAuth()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.read == true
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.message == resource.data.message;
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------
    // REPORTS COLLECTION  /reports/{reportId}
    // Authenticated users submit reports; only admin can read/delete
    // --------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isAuth()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.adId is string
        && request.resource.data.reason is string;
      allow read:   if isAdmin();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------
    // REVIEWS COLLECTION  /reviews/{reviewId}
    // Anyone can read; authenticated non-owners can create once per ad;
    // owner or admin can delete
    // --------------------------------------------------------
    match /reviews/{reviewId} {
      // Public read — anyone can see reviews (including unauthenticated)
      allow read: if true;

      // Authenticated user can create a review
      //   - reviewerId must match the signed-in user
      //   - rating must be 1–5
      //   - cannot review their own listing
      allow create: if isAuth()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.ownerId != request.auth.uid;

      // Only the reviewer or an admin can delete a review
      allow delete: if isAuth()
        && (resource.data.reviewerId == request.auth.uid || isAdmin());

      // No updates allowed — reviews are immutable once submitted
      allow update: if false;
    }

    // --------------------------------------------------------
    // CONTACT MESSAGES  /contact_messages/{msgId}
    // Anyone can submit; only admin can read
    // --------------------------------------------------------
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------
    // CONFIG COLLECTION  /config/{docId}
    // Public read (pricing, bank details shown to users); admin write only
    // --------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --------------------------------------------------------
    // FEATURE REQUESTS  /feature_requests/{reqId}
    // Users submit boost requests; admin reviews and approves
    // --------------------------------------------------------
    match /feature_requests/{reqId} {
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --------------------------------------------------------
    // Deny everything else by default
    // --------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
